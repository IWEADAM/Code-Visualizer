rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Primitives & Path Variable Hardening
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Pillar 2: Validation Blueprint synchronized verbatim with firebase-blueprint.json
    function isValidRepoHistory(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'description',
          'repoUrl',
          'language',
          'fileCount',
          'filesPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'name',
          'description',
          'repoUrl',
          'language',
          'fileCount',
          'filesPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.description is string &&
        data.description.size() >= 0 &&
        data.description.size() <= 500 &&
        data.repoUrl is string &&
        data.repoUrl.size() >= 0 &&
        data.repoUrl.size() <= 500 &&
        data.language is string &&
        data.language.size() >= 1 &&
        data.language.size() <= 60 &&
        data.fileCount is number &&
        data.fileCount >= 1 &&
        data.fileCount <= 500 &&
        data.filesPayload is string &&
        data.filesPayload.size() >= 2 &&
        data.filesPayload.size() <= 900000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /repoHistory/{repoId} {
      allow get: if isSignedIn() && isValidId(repoId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(repoId) &&
        isValidRepoHistory(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(repoId) &&
        isValidRepoHistory(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'repoUrl',
          'language',
          'fileCount',
          'filesPayload',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(repoId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
